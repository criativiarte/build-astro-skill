---
export interface Props {
  phone: string;
  message?: string;
  tooltip?: string;
  showOnLoad?: boolean;
}

const { phone, message, tooltip, showOnLoad = true } = Astro.props;

const number = phone.replace(/[\s()+.-]/g, "");

if (!/^[1-9]\d{7,14}$/.test(number)) {
  throw new Error("WhatsAppButton: informe um telefone internacional com DDI e DDD.");
}

const label = tooltip?.trim();
const initialMessage = message?.trim();
const url = new URL(`https://wa.me/${number}`);

if (initialMessage) {
  url.searchParams.set("text", initialMessage);
}
---

<whatsapp-button
  class="whatsapp"
  data-intro={(label && showOnLoad) || undefined}
>
  <a
    class="whatsapp__button"
    href={url.href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${label || "Contato"} pelo WhatsApp (abre em uma nova aba)`}
    data-astro-prefetch="false"
  >
    <svg
      viewBox="0 0 24 24"
      width="32"
      height="32"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M20.52 3.449A11.855 11.855 0 0 0 12.004 0C5.392 0 .013 5.38.01 11.993c0 2.114.552 4.178 1.6 6L0 24l6.335-1.652a12.01 12.01 0 0 0 5.666 1.443h.005c6.611 0 11.99-5.38 11.994-11.994a11.922 11.922 0 0 0-3.48-8.348zM12.006 21.77h-.004a9.964 9.964 0 0 1-5.063-1.386l-.363-.216-3.76.982 1.004-3.668-.237-.376a9.94 9.94 0 0 1-1.527-5.113c.002-5.495 4.474-9.966 9.974-9.966a9.9 9.9 0 0 1 7.044 2.922 9.9 9.9 0 0 1 2.916 7.046c-.003 5.495-4.475 9.966-9.984 9.966zm5.464-7.464c-.3-.15-1.773-.875-2.048-.975-.275-.1-.475-.15-.675.15-.2.3-.774.975-.949 1.175-.175.2-.35.225-.65.075-.3-.15-1.266-.467-2.411-1.488-.892-.795-1.494-1.777-1.669-2.077-.175-.3-.018-.462.132-.611.135-.134.3-.35.45-.525.15-.175.2-.3.3-.5.1-.2.05-.375-.025-.525-.075-.15-.675-1.625-.925-2.225-.243-.584-.49-.505-.675-.515-.175-.009-.375-.011-.575-.011-.2 0-.525.075-.8.375s-1.05 1.025-1.05 2.5 1.075 2.9 1.225 3.1c.15.2 2.116 3.232 5.126 4.532.716.309 1.275.494 1.71.632.719.228 1.373.196 1.89.119.577-.086 1.773-.725 2.023-1.425.25-.7.25-1.3.175-1.425-.075-.125-.275-.2-.575-.35z" />
    </svg>
  </a>
  {label && <span class="whatsapp__tooltip" aria-hidden="true">{label}</span>}
</whatsapp-button>

<script>
  class WhatsAppButton extends HTMLElement {
    connectedCallback() {
      if (!this.hasAttribute("data-intro")) return;

      const endIntro = () => this.removeAttribute("data-intro");

      for (const event of ["pointerenter", "focusin", "animationend"]) {
        this.addEventListener(event, endIntro, { once: true });
      }
    }
  }

  if (!customElements.get("whatsapp-button")) {
    customElements.define("whatsapp-button", WhatsAppButton);
  }
</script>

<style>
  .whatsapp {
    --whatsapp-size: 3.5rem;
    position: fixed;
    bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
    right: calc(1.25rem + env(safe-area-inset-right, 0px));
    z-index: 50;
    font-family: var(--font-sans, system-ui, sans-serif);
  }

  .whatsapp__button {
    display: grid;
    place-items: center;
    width: var(--whatsapp-size);
    height: var(--whatsapp-size);
    border: 0;
    border-radius: 50%;
    background: linear-gradient(160deg, #32de84, #19c66b 50%, #0ea563);
    background-size: 100% 200%;
    background-position: center top;
    color: #fff;
    box-shadow: var(--shadow-tooltip, 0 4px 24px rgb(0 0 0 / 4%));
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: background-position 500ms cubic-bezier(0.22, 1, 0.36, 1) 60ms;
  }

  .whatsapp__button:focus-visible {
    outline: 2px solid var(--color-ink, oklch(14.1% 0.005 285.823));
    outline-offset: 3px;
  }

  .whatsapp__tooltip {
    position: absolute;
    top: 50%;
    right: calc(100% + 0.75rem);
    width: max-content;
    max-width: min(18rem, calc(100vw - var(--whatsapp-size) - 4rem - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px)));
    box-sizing: border-box;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-lg, 0.75rem);
    background: var(--color-surface, #fff);
    color: var(--color-body, oklch(44.2% 0.017 285.786));
    box-shadow: var(--shadow-tooltip, 0 4px 24px rgb(0 0 0 / 4%));
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.4;
    overflow-wrap: anywhere;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-50%);
    transition: opacity 200ms ease, visibility 200ms ease;
  }

  /* A primeira interação encerra esta apresentação sem reiniciá-la. */
  .whatsapp[data-intro] .whatsapp__tooltip {
    animation: whatsapp-tooltip-intro 3s ease both;
  }

  .whatsapp__button:focus-visible + .whatsapp__tooltip {
    opacity: 1;
    visibility: visible;
  }

  @media (hover: hover) {
    .whatsapp__button:hover {
      background-position: center bottom;
    }

    .whatsapp__button:hover + .whatsapp__tooltip {
      opacity: 1;
      visibility: visible;
    }
  }

  @keyframes whatsapp-tooltip-intro {
    0%, 100% {
      opacity: 0;
      visibility: hidden;
    }
    5.333%, 94.667% {
      opacity: 1;
      visibility: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp__button,
    .whatsapp__tooltip {
      transition: none;
    }

    .whatsapp[data-intro] .whatsapp__tooltip {
      animation-timing-function: steps(1, end);
    }

    @keyframes whatsapp-tooltip-intro {
      from { opacity: 1; visibility: visible; }
      to { opacity: 0; visibility: hidden; }
    }
  }
</style>
