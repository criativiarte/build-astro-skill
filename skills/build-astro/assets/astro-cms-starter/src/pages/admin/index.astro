<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Painel</title>

    <!-- Content Security Policy -->
    <meta
      http-equiv="Content-Security-Policy"
      content="
      default-src 'self';
      script-src 'self' https://unpkg.com 'unsafe-inline' 'unsafe-eval';
      style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net;
      font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net;
      img-src 'self' data: blob: https://avatars.githubusercontent.com https://gitlab.com;
      connect-src 'self' data: https://unpkg.com https://api.github.com https://raw.githubusercontent.com https://www.githubstatus.com https://gitlab.com;
      manifest-src 'self' blob:;
      frame-src 'none';
      form-action 'self';
    "
    />
  </head>

  <body>
    <script is:inline>window.CMS_MANUAL_INIT = true;</script>
    <script is:inline src="https://unpkg.com/@sveltia/cms/dist/sveltia-cms.js"
    ></script>
    <script>
      import { normalizeScriptSnippet } from "@/utils/scripts";

      interface CmsEntry {
        get(key: string): unknown;
        getIn(keys: string[]): unknown;
      }

      const { CMS } = window as typeof window & {
        CMS: {
          registerEventListener(listener: {
            name: "preSave";
            handler: (event: { entry: CmsEntry }) => void;
          }): void;
          init(): Promise<void>;
        };
      };

      CMS.registerEventListener({
        name: "preSave",
        handler: ({ entry }) => {
          if (entry.get("collection") === "scripts") {
            normalizeScriptSnippet(String(entry.getIn(["data", "code"]) ?? ""));
          }
        },
      });

      void CMS.init();
    </script>
  </body>
</html>
