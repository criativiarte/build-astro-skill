---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/layout/Container.astro";
import { Icon } from "astro-icon/components";
---

<Layout>
  <Container class="py-16 md:py-20">
    <section class="space-y-6 max-w-reading">
      <p class="font-semibold text-muted text-sm uppercase tracking-wide">
        Astro + CMS
      </p>
      <h1 class="heading-1">
        Um template simples para publicar conteúdo com Astro.
      </h1>
      <p class="text-body text-lg md:text-xl">
        Uma base para sites pequenos, com posts gerenciados pelo Sveltia CMS
        e contato pelo WhatsApp.
      </p>
      <div class="flex sm:flex-row flex-col gap-3">
        <a class="gap-2 button button-primary" href="/posts/">
          Ver posts
          <Icon name="lucide:arrow-right" size={20} aria-hidden="true" />
        </a>
        <a
          class="gap-2 button button-secondary"
          href="/admin/"
          target="_blank"
          rel="nofollow"
        >
          Abrir painel
          <Icon name="lucide:arrow-right" size={20} aria-hidden="true" />
        </a>
      </div>
    </section>

    <section class="gap-4 grid md:grid-cols-3 mt-16">
      <article class="bg-surface p-5 border border-line rounded-lg">
        <h2 class="heading-3">Estrutura pequena</h2>
        <p class="mt-3 text-body">
          Páginas, componentes e conteúdo organizados para adaptar o template
          às necessidades de cada projeto.
        </p>
      </article>
      <article class="bg-surface p-5 border border-line rounded-lg">
        <h2 class="heading-3">Tailwind direto</h2>
        <p class="mt-3 text-body">
          Classes utilitárias simples para que você consiga trocar o visual
          rapidamente.
        </p>
      </article>
      <article class="bg-surface p-5 border border-line rounded-lg">
        <h2 class="heading-3">Conteúdo pelo CMS</h2>
        <p class="mt-3 text-body">
          Gerencie posts, autores, tags e o botão do WhatsApp pelo painel.
          As alterações ficam no GitHub e entram no site após o build e deploy.
        </p>
      </article>
    </section>
  </Container>
</Layout>
